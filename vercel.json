{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "josean-araujo.vercel.app"
        }
      ],
      "destination": "https://joseanaraujo.com/$1",
      "permanent": true
    },
    {
      "source": "/estudos/sta",
      "destination": "/projetos/sta/",
      "permanent": true
    },
    {
      "source": "/estudos/sta/",
      "destination": "/projetos/sta/",
      "permanent": true
    },
    {
      "source": "/estudos/isola",
      "destination": "/projetos/isola/",
      "permanent": true
    },
    {
      "source": "/estudos/isola/",
      "destination": "/projetos/isola/",
      "permanent": true
    },
    {
      "source": "/estudos/bayro",
      "destination": "/projetos/bayro/",
      "permanent": true
    },
    {
      "source": "/estudos/bayro/",
      "destination": "/projetos/bayro/",
      "permanent": true
    },
    {
      "source": "/estudos",
      "destination": "/#indice",
      "permanent": true
    },
    {
      "source": "/estudos/",
      "destination": "/#indice",
      "permanent": true
    },
    {
      "source": "/estudos/:slug",
      "destination": "/#indice",
      "permanent": true
    },
    {
      "source": "/estudos/:slug/",
      "destination": "/#indice",
      "permanent": true
    },
    {
      "source": "/en/studies/sta",
      "destination": "/en/work/sta/",
      "permanent": true
    },
    {
